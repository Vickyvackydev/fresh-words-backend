PORT=8080
ENV=development

# Database Settings
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=fresh_words_db
DB_SSLMODE=disable

# Authentication
JWT_SECRET=your_jwt_secret_here

# Admin Bootstrap Credentials
ADMIN_EMAIL=admin@freshdevotions.org
ADMIN_PASSWORD=your_admin_password_here

# Google Gemini API Key for dynamic multi-language devotional & hymn translation
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
